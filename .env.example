# Copy to .env locally — never commit real values.
# World-builder Express (optional Mongo; falls back to in-memory)
PORT=8787
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=graphics_pipeline
# Set to 1 to require Mongo (GET /api/assets returns 503 if down)
# MONGO_REQUIRED=0

# Blender CLI (optional; pipeline.sh uses `blender` on PATH if unset)
# BLENDER_BIN=/usr/bin/blender
# BLENDER_VERSION_TESTED=5.2.3

# S2-A live smoke (Windows): require real Blender; never demo GLB
# SMOKE_LIVE=1
# BLENDER_BIN=C:\Program Files\Blender Foundation\Blender 5.2\blender.exe
# Krita MCP bridge (default 9797). Health is red when unreachable if SMOKE_LIVE=1
# or HEALTH_STRICT_KRITA=1. CI/local without Krita: KRITA_HEALTH_MODE=cli|off
# KRITA_MCP_PORT=9797
# HEALTH_STRICT_KRITA=0
# KRITA_HEALTH_MODE=bridge

# S3-F #52 — Krita bridge mode: vendor (default, KRITA_MCP_PORT 9797) | firstparty (KRITA_FP_PORT 19876)
# | mock. Anything else → CONFIG_INVALID at start. 401/403 from the bridge = "unauthorized", not "down".
# BRIDGE=vendor
# S3-F #128 — activity.jsonl rotation cap (test-only override; default 10000 lines)
# ACTIVITY_MAX_LINES=10000
# S3-F #85 — share QR base: absolute http(s) origin, no path/query/hash (else CONFIG_INVALID at start).
# Unset → the client uses location.origin (loopback links show "This link only works on this device.").
# PUBLIC_BASE_URL=https://world.example.com
# S3-G CO-4 — client dev-server ports (a second stack, e.g. UI repeat runs, never collides):
# VITE_PORT=5173
# WB_API_PORT=8787
# S3-G #78 — inbox PNG TTL in hours (integer 1..8760, default 168). Swept at start + hourly; only
# *.png directly in data/inbox, never symlinks, files referenced by a registered asset are kept.
# INBOX_TTL_HOURS=168
# S3-G #72 — webhook on asset.register / asset.delete. OFF unless WEBHOOK_URL is set (absolute https URL).
# Every A/AAAA record is vetted (loopback/private/link-local/metadata/mapped ranges refused), the IP is
# pinned, redirects are refused. Bad values → CONFIG_INVALID naming the variable.
# WEBHOOK_URL=https://hooks.example.com/graphics
# WEBHOOK_SECRET=at-least-16-characters   # → X-Webhook-Signature: sha256=<hex HMAC of body>
# WEBHOOK_ALLOW_HTTP=0                    # 1 allows http: URLs
# WEBHOOK_ALLOW_PRIVATE=0                 # TEST-ONLY, DANGEROUS: lifts the address-range check (SSRF)
