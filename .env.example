# Copy to .env locally — never commit real values.
# World-builder Express (optional Mongo; falls back to in-memory)
PORT=8787
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=graphics_pipeline
# Set to 1 to require Mongo (GET /api/assets returns 503 if down)
# MONGO_REQUIRED=0

# Blender CLI (optional; pipeline.sh uses `blender` on PATH if unset)
# BLENDER_BIN=/usr/bin/blender
# BLENDER_VERSION_TESTED=5.2.3
