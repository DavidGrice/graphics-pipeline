{
  "name": "graphics-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Krita MCP \u2192 Blender GLB \u2192 MERN + R3F world builder (Sprint 1 MVP)",
  "workspaces": [
    "packages/*",
    "apps/mcp-krita",
    "apps/world-builder",
    "apps/world-builder/client"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:schema": "npm run build -w @graphics-pipeline/asset-schema",
    "dev:world": "npm run dev -w @graphics-pipeline/world-builder",
    "dev:client": "npm run dev -w @graphics-pipeline/world-builder-client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test:s1": "node --test tests/s1-*.test.mjs tests/s2a-*.test.mjs tests/s2d-*.test.mjs tests/s2e-*.test.mjs tests/s2f-*.test.mjs tests/s2g-*.test.mjs tests/s3a-*.test.mjs tests/s3b-*.test.mjs tests/s3c-*.test.mjs",
    "smoke:live": "bash apps/blender-pipeline/smoke_live.sh",
    "test:s2a": "node --test tests/s2a-*.test.mjs",
    "test:s2b": "node --test tests/s2b-*.test.mjs",
    "test:golden": "node --test tests/s3c-golden-seed.test.mjs",
    "golden:refresh": "node scripts/refresh-goldens.mjs",
    "pack:assets": "node apps/blender-pipeline/pack_assets.mjs",
    "import:pack": "node apps/blender-pipeline/import_pack.mjs"
  },
  "license": "MIT"
}
